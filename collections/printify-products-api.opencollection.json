              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a list of all products in a shop."
        },
        {
          "info": {
            "name": "Create a new product in a shop.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.printify.com/v1/shops/:shop_id/products.json",
